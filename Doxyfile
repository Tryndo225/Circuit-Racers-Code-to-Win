#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "Circuit-Racers : Code-To-Win"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Docs for level generation, track management, UI, editor utilities, and deprecated wheel prototype."
OUTPUT_DIRECTORY       = ./docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = ./
INLINE_INHERITED_MEMB  = YES
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_CSHARP = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_SCOPE_NAMES       = NO
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_BRIEF_DOCS        = YES
SORT_BY_SCOPE_NAME     = YES
ALPHABETICAL_INDEX     = YES
MULTILINE_CPP_IS_BRIEF = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
TOC_INCLUDE_HEADINGS   = 3
INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           =

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# Adjust INPUT as needed. This setup crawls the whole repo except ./docs.
INPUT                  = ./
RECURSIVE              = YES
FILE_PATTERNS          = *.cs *.md
EXCLUDE                = ./docs
EXCLUDE_PATTERNS       = */obj/* */bin/* */Library/* */Temp/* */Logs/* */.git/*

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = .
HTML_TIMESTAMP         = NO
GENERATE_TREEVIEW      = YES
ENUM_VALUES_PER_LINE   = 1
DISABLE_INDEX          = NO
GENERATE_DOCSET        = NO
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# LaTeX / Man / RTF / XML
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_PERLMOD       = NO

#---------------------------------------------------------------------------
# Diagrams (Dot / GraphViz)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_PATH               = "C:/Program Files/Graphviz/bin"
DOT_FONTPATH           = "C:/Windows/Fonts"
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES
INTERACTIVE_SVG        = YES

# High-level graphs
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
GROUP_GRAPHS           = YES

# Tuning to keep page weights reasonable on GH Pages
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 2
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES

#---------------------------------------------------------------------------
# Source Browser
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = \
  UNITY_EDITOR \
  DOXYGEN